{
  "name": "receiverproxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:embed": "svelte-check --tsconfig ./tsconfig.json && ADAPTER=static vite build",
    "deploy": "wrangler deploy",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "wasm": "sh scripts/build-wasm.sh",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.4.1",
    "smol-toml": "1.8.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "wrangler": "4.128.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
